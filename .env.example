# Node 24+. Generate each secret independently: openssl rand -hex 32
# Never use NEXT_PUBLIC_ prefixes for these values.
ADMIN_TOKEN=
CRON_SECRET=
# Optional absolute path on a durable writable volume. Defaults to .data/atlas.sqlite.
# ATLAS_DB_PATH=/var/lib/consumer-atlas/atlas.sqlite
# Browser tests default to the cloud machine's system Chromium.
CHROMIUM_PATH=/usr/bin/chromium
